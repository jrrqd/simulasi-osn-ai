# Copy to /etc/osnai/env on the VPS (chmod 600). Do not commit real secrets.

NODE_ENV=production

# Prefer Postgres on the VPS (PGlite is fine for local only).
USE_PGLITE=false
DATABASE_URL=postgresql://osnai:change-me@127.0.0.1:5432/osnai

# Replace with your public URL (domain or IP). Never commit real secrets.
BETTER_AUTH_URL=https://your.domain.example
NEXT_PUBLIC_APP_URL=https://your.domain.example
TRUSTED_ORIGINS=https://your.domain.example

# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-long-random-secret

# Generate: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=use-a-strong-unique-password
ADMIN_NAME=Administrator

ALLOW_LOCAL_AI_PROVIDER=false

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL_ID=MiniMax-M3
