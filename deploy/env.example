# Copy to /etc/osnai/env on the VPS (chmod 600). Do not commit real secrets.

NODE_ENV=production

# Prefer Postgres on the VPS (PGlite is fine for local only).
USE_PGLITE=false
DATABASE_URL=postgresql://osnai:change-me@127.0.0.1:5432/osnai

# Origin only. A path here (for example /simosnai) replaces the /api/auth
# mount and login returns 404. The app subpath belongs on NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=https://radr.nxtdev.xyz
NEXT_PUBLIC_APP_URL=https://radr.nxtdev.xyz/simosnai
NEXT_PUBLIC_BASE_PATH=/simosnai
TRUSTED_ORIGINS=https://radr.nxtdev.xyz

# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-long-random-secret

# Generate: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

# Bootstrap admin. Additional admins must be promoted by an existing admin
# (Admin → Users); roles are never granted from self-registration emails.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-strong-unique-password
ADMIN_NAME=Administrator

ALLOW_LOCAL_AI_PROVIDER=false
# Extra AI provider hosts beyond the built-in allowlist (comma-separated).
# AI_PROVIDER_HOST_ALLOWLIST=

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL_ID=MiniMax-M3
