# Local without Docker: embedded Postgres (PGlite)
USE_PGLITE=true

# Production / Docker Postgres:
# USE_PGLITE=false
# DATABASE_URL=postgresql://osnai:osnai@localhost:5432/osnai

BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Generate: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Extra browser origins allowed for auth (comma-separated), e.g. LAN + Tailscale
# TRUSTED_ORIGINS=http://192.168.1.10:3000,http://100.x.y.z:3000
ALLOW_LOCAL_AI_PROVIDER=true

# Default LLM for all users (MiniMax M3). Set your MiniMax API key to enable
# AI features without any per-user or admin configuration.
# Priority: student BYOK > admin shared provider > this default.
MINIMAX_API_KEY=
# Optional overrides:
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL_ID=MiniMax-M3
# Image generation (geometry figures in simulasi). Defaults to image-01 on the same base URL.
# MINIMAX_IMAGE_MODEL_ID=image-01
# MINIMAX_IMAGE_BASE_URL=https://api.minimax.io/v1
# On-disk figure storage (local default: .data/figures; VPS default: /var/www/osnai/figures)
# FIGURES_DIR=.data/figures

# First admin is created automatically when both values are present.
# Always use a strong, unique password in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrator
ADMIN_EMAILS=admin@example.com

# Judge0 server-side grader for hidden test cases. Required for
# codeSpec scoring in attempts / mocks. Server-only — never exposed
# to the browser.
# Self-hosted: spin up the Judge0 docker image and set its base URL.
# JUDGE0_BASE_URL=http://localhost:2358
# Language id for Python 3 (Judge0 default = 71). Override only if you
# know the exact id your Judge0 build exposes.
# JUDGE0_LANGUAGE_ID=71
# RapidAPI/RapidAPI-style auth. Optional for self-hosted instances;
# required when calling RapidAPI's Judge0 endpoint.
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
